{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@cmms/ui": ["../../packages/ui/src/index.ts"],
      "@cmms/types": ["../../packages/types/src/index.ts"],
      "@cmms/api-client": ["../../packages/api-client/src/index.ts"]
    }
  },
  "include": ["src", "../../packages/ui/src", "../../packages/types/src", "../../packages/api-client/src"]
}
